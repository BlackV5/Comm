<Window x:Class="WpfApp1.SerialPortSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙ 串口参数设置" 
        Height="320" 
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinHeight="280"
        MinWidth="380">

    <Window.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="55"/>
        </Style>
        <Style x:Key="SettingComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="75"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="串口参数设置" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- 参数区域 -->
        <WrapPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,10">
            <!-- 第一行 -->
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="波特率：" Style="{StaticResource SettingLabel}"/>
                <ComboBox x:Name="comboBaud" Style="{StaticResource SettingComboBox}" Width="100"/>

                <TextBlock Text="数据位：" Style="{StaticResource SettingLabel}" Margin="20,0,8,0"/>
                <ComboBox x:Name="comboDataBits" Style="{StaticResource SettingComboBox}" Width="60"/>
            </WrapPanel>

            <!-- 第二行 -->
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="停止位：" Style="{StaticResource SettingLabel}"/>
                <ComboBox x:Name="comboStopBits" Style="{StaticResource SettingComboBox}" Width="80"/>

                <TextBlock Text="校验位：" Style="{StaticResource SettingLabel}" Margin="20,0,8,0"/>
                <ComboBox x:Name="comboParity" Style="{StaticResource SettingComboBox}" Width="80"/>
            </WrapPanel>

            <!-- 当前参数预览 -->
            <Border Grid.Row="2" 
                    BorderBrush="#DDDDDD" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,5,0,0"
                    Background="#F9F9F9">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="当前配置：" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="labPreview" Text="9600bps, 8数据位, 1停止位, 无校验" FontSize="12" Foreground="#555555" VerticalAlignment="Center"/>
                </WrapPanel>
            </Border>
        </WrapPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnOK" 
                    Content="确定" 
                    Style="{StaticResource PrimaryButton}"
                    Click="btnOK_Click"
                    IsDefault="True"/>
            <Button x:Name="btnCancel" 
                    Content="取消" 
                    Style="{StaticResource DialogButton}"
                    Click="btnCancel_Click"
                    IsCancel="True"
                    Background="#E0E0E0"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>