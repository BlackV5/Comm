<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1"
        Title="串口调试工具" 
        Height="670" 
        Width="800"
        MinHeight="520"
        MinWidth="650"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- 清空按钮样式 -->
        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C0392B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#A93226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置按钮样式 -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" 
                   Text="串口调试工具" 
                   FontSize="18" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Tab 切换 -->
        <TabControl Grid.Row="1" Margin="0,0,0,10">
            <TabItem Header="串口控制">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ===== 串口设置（简洁版） ===== -->
                    <Border Grid.Row="0" 
                            BorderBrush="#AAAAAA" 
                            BorderThickness="1" 
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 端口 -->
                            <TextBlock Text="端口：" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="comboPort" Width="100" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <!-- 刷新按钮 -->
                            <Button x:Name="btnRefreshPorts" 
                                    Content="🔄" 
                                    Click="btnRefreshPorts_Click" 
                                    Width="30" 
                                    Height="26"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    FontSize="14"
                                    ToolTip="刷新串口列表"/>

                            <!-- 波特率 -->
                            <TextBlock Text="波特率：" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="comboBaud" Width="90" Height="26" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <!-- 更多设置按钮 -->
                            <Button x:Name="btnMoreSettings" 
                                    Content="⚙ 更多" 
                                    Style="{StaticResource SettingsButtonStyle}"
                                    Click="btnMoreSettings_Click"
                                    VerticalAlignment="Center"
                                    ToolTip="更多串口参数设置（数据位、停止位、校验位）"/>

                            <!-- 打开按钮 -->
                            <Button x:Name="btnOpen" 
                                    Content="打开串口" 
                                    Click="btnOpen_Click" 
                                    Width="85" 
                                    Height="28"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"/>
                        </WrapPanel>
                    </Border>

                    <!-- ===== 发送区 ===== -->
                    <Border Grid.Row="1" 
                            BorderBrush="#AAAAAA" 
                            BorderThickness="1" 
                            CornerRadius="4"
                            Padding="8"
                            Height="60">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="发送：" Grid.Column="0" 
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Margin="0,0,5,0"/>

                            <TextBox x:Name="textBoxSend" 
                                     Grid.Column="1" 
                                     Margin="0,0,8,0"
                                     KeyDown="textBoxSend_KeyDown"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     Height="30"
                                     VerticalContentAlignment="Center"/>

                            <CheckBox x:Name="chkHexSend" 
                                      Grid.Column="2" 
                                      Content="Hex" 
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>

                            <Button x:Name="btnSend" 
                                    Grid.Column="3" 
                                    Content="发送" 
                                    Click="btnSend_Click" 
                                    Width="65" 
                                    Height="30"
                                    Margin="0,0,6,0"/>

                            <Button x:Name="btnSave" 
                                    Grid.Column="4" 
                                    Content="保存日志" 
                                    Click="SaveLog" 
                                    Width="75" 
                                    Height="30"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="快捷发送">
                <local:QuickSendControl x:Name="QuickSendControl" Margin="0,10,0,0"/>
            </TabItem>
        </TabControl>

        <!-- ===== 全局接收区 ===== -->
        <Border Grid.Row="2" 
                BorderBrush="#AAAAAA" 
                BorderThickness="1" 
                CornerRadius="4"
                Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 接收区标题栏 -->
                <Border Grid.Row="0" 
                        Background="#EEEEEE" 
                        Padding="8,4"
                        CornerRadius="4,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📋 接收区" FontWeight="Bold" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" x:Name="labStatus" 
                                   Foreground="Gray" 
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="就绪"/>

                        <CheckBox x:Name="chkTopMost" 
                                  Grid.Column="2"
                                  Content="📌 置顶" 
                                  IsChecked="False"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,0"
                                  FontSize="12"
                                  Checked="chkTopMost_Checked"
                                  Unchecked="chkTopMost_Unchecked"/>

                        <CheckBox x:Name="chkAutoScroll" 
                                  Grid.Column="3"
                                  Content="自动滚屏" 
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,0,15,0"
                                  FontSize="12"/>

                        <Button x:Name="btnClear" 
                                Grid.Column="4"
                                Content="🗑 清空" 
                                Click="btnClear_Click"
                                Style="{StaticResource ClearButtonStyle}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 接收文本框（带右键菜单） -->
                <TextBox x:Name="textBoxReceive" 
                         Grid.Row="1" 
                         Background="White"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Visible"
                         BorderThickness="0"
                         Padding="8,4"
                         AcceptsReturn="True">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制" Click="CopyReceiveData" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="全选" Click="SelectAllReceiveData" InputGestureText="Ctrl+A"/>
                            <Separator/>
                            <MenuItem Header="清空" Click="btnClear_Click"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>

                <!-- 状态栏 -->
                <Border Grid.Row="2" 
                        Background="#EEEEEE" 
                        Padding="8,3"
                        CornerRadius="0,0,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="11">
                            <Run Text="接收字节："/>
                            <Run x:Name="labReceiveCount" Text="0" Foreground="Green" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBlock Grid.Column="1" FontSize="11" HorizontalAlignment="Center">
                            <Run Text="发送字节："/>
                            <Run x:Name="labSendCount" Text="0" Foreground="Blue" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Right" Foreground="Gray">
                            <Run Text="按 Enter 快速发送"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>